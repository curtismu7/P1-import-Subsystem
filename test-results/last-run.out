                <div class=\"modal-footer\" style=\"display:flex; gap:10px;\">
                    <button class=\"btn btn-secondary\" id=\"details-copy\">Copy</button>
                    <button class=\"btn btn-primary\" id=\"details-close\">Close</button>
                </div>
